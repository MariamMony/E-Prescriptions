<UserControl x:Class="ePrescriptions.App.Views.FinanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}">

    <Grid Background="Transparent">
        <Border Background="White" CornerRadius="12" Margin="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- رأس الشاشة -->
                <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" CornerRadius="12,12,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFinance}" Fill="#FBBF24" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0" />
                            <TextBlock Text="الحسابات المالية والمصروفات وإقرار ضريبة القيمة المضافة" FontSize="20" FontWeight="Bold" Foreground="White" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="من: " Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <DatePicker SelectedDate="{Binding StartDate}" Height="34" Margin="0,0,10,0" />
                            <TextBlock Text="إلى: " Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <DatePicker SelectedDate="{Binding EndDate}" Height="34" Margin="0,0,12,0" />
                            <Button Command="{Binding RefreshCommand}" Style="{StaticResource PosActionButton}" Background="#3B82F6" Padding="12,6">
                                <TextBlock Text="تحديث التقارير" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- المحتوى بالتبويبات -->
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10">
                    <!-- التبويب 1: المصروفات وإضافة مصروف -->
                    <TabItem Header="المصروفات التشغيلية" FontSize="14" FontWeight="Bold" Padding="16,8">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <!-- جدول المصروفات -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                                <DataGrid ItemsSource="{Binding ExpensesList}" Style="{StaticResource AppFastDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="الرقم" Binding="{Binding ExpenseNumber}" Width="110" IsReadOnly="True" />
                                        <DataGridTextColumn Header="التصنيف" Binding="{Binding Category}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="التاريخ" Binding="{Binding FormattedDate}" Width="100" IsReadOnly="True" />
                                        <DataGridTextColumn Header="المستفيد" Binding="{Binding PaidTo}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="المبلغ" Binding="{Binding FormattedAmount}" Width="110" IsReadOnly="True" />
                                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- استمارة إضافة مصروف -->
                            <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="تسجيل مصروف تشغيلي جديد" FontWeight="Bold" FontSize="15" Foreground="#1E1B4B" Margin="0,0,0,12" />

                                    <TextBlock Text="بند المصروف:" Foreground="#475569" Margin="0,4,0,2" />
                                    <ComboBox Text="{Binding NewExpenseCategory, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{StaticResource AppComboBox}">
                                        <ComboBoxItem Content="إيجار ومرافق" IsSelected="True" />
                                        <ComboBoxItem Content="كهرباء ومياه" />
                                        <ComboBoxItem Content="رواتب وأجور" />
                                        <ComboBoxItem Content="صيانة ونظافة" />
                                        <ComboBoxItem Content="مستلزمات مكتبية" />
                                        <ComboBoxItem Content="أخرى" />
                                    </ComboBox>

                                    <TextBlock Text="المبلغ (ج.م):" Foreground="#475569" Margin="0,8,0,2" />
                                    <TextBox Text="{Binding NewExpenseAmountPounds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" FontWeight="Bold" FontSize="16" TextAlignment="Center" />

                                    <TextBlock Text="المدفوع له (المستفيد):" Foreground="#475569" Margin="0,8,0,2" />
                                    <TextBox Text="{Binding NewExpensePaidTo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />

                                    <TextBlock Text="ملاحظات / بيان:" Foreground="#475569" Margin="0,8,0,2" />
                                    <TextBox Text="{Binding NewExpenseNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="50" AcceptsReturn="True" />

                                    <Button Command="{Binding AddExpenseCommand}" Style="{StaticResource PosActionButton}" Background="#EF4444" Margin="0,16,0,0">
                                        <TextBlock Text="تسجيل المصروف والقيد اليومي" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- التبويب 2: إقرار ضريبة القيمة المضافة -->
                    <TabItem Header="إقرار ضريبة القيمة المضافة (VAT)" FontSize="14" FontWeight="Bold" Padding="16,8">
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                            <StackPanel MaxWidth="700" HorizontalAlignment="Right">
                                <TextBlock Text="ملخص الإقرار الضريبي عن الفترة المحددة" FontWeight="Bold" FontSize="18" Foreground="#1E1B4B" Margin="0,0,0,16" />

                                <!-- المبيعات (المخرجات) -->
                                <Border Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="1) مبيعات الفترة الخاضعة للضريبة 15%:" FontWeight="Bold" Foreground="#0F172A" />
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedTaxableSales}" FontWeight="Bold" Margin="0,0,20,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedSalesVat, StringFormat='ضريبة المخرجات: {0}'}" FontWeight="Bold" Foreground="#2563EB" />
                                    </Grid>
                                </Border>

                                <!-- المشتريات (المدخلات) -->
                                <Border Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="2) مشتريات الفترة الخاضعة للضريبة 15%:" FontWeight="Bold" Foreground="#0F172A" />
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedTaxablePurchases}" FontWeight="Bold" Margin="0,0,20,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedPurchasesVat, StringFormat='ضريبة المدخلات: {0}'}" FontWeight="Bold" Foreground="#059669" />
                                    </Grid>
                                </Border>

                                <!-- صافي الضريبة المستحقة -->
                                <Border Background="#1E1B4B" CornerRadius="10" Padding="20,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="صافي الضريبة الواجبة للسداد (المخرجات − المدخلات):" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedNetVat}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- التبويب 3: التدفق النقدي -->
                    <TabItem Header="تقرير التدفق النقدي" FontSize="14" FontWeight="Bold" Padding="16,8">
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                            <StackPanel MaxWidth="650" HorizontalAlignment="Right">
                                <TextBlock Text="تقرير حركة التدفقات النقدية (السيولة)" FontWeight="Bold" FontSize="18" Foreground="#1E1B4B" Margin="0,0,0,16" />

                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="إجمالي المقبوضات النقدية الداخلة (مبيعات + تحصيلات):" FontWeight="Bold" Foreground="#065F46" />
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedInflow}" FontWeight="Bold" Foreground="#059669" FontSize="16" />
                                    </Grid>
                                </Border>

                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="إجمالي المدفوعات النقدية الخارجة (مشتريات + سداد موردين + مصروفات):" FontWeight="Bold" Foreground="#991B1B" />
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedOutflow}" FontWeight="Bold" Foreground="#DC2626" FontSize="16" />
                                    </Grid>
                                </Border>

                                <Border Background="#0F172A" CornerRadius="10" Padding="18,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="صافي التدفق النقدي للفترة:" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedNetCashFlow}" FontSize="22" FontWeight="Bold" Foreground="White" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- التبويب 4: القيود اليومية -->
                    <TabItem Header="دفتر القيود اليومية" FontSize="14" FontWeight="Bold" Padding="16,8">
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding JournalEntriesList}" Style="{StaticResource AppFastDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم القيد" Binding="{Binding EntryNumber}" Width="120" IsReadOnly="True" />
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" Width="110" IsReadOnly="True" />
                                    <DataGridTextColumn Header="البيان والشرح" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="من حـ/ (مدين)" Binding="{Binding DebitAccount}" Width="140" IsReadOnly="True" />
                                    <DataGridTextColumn Header="إلى حـ/ (دائن)" Binding="{Binding CreditAccount}" Width="140" IsReadOnly="True" />
                                    <DataGridTextColumn Header="المبلغ (هللات/قروش)" Binding="{Binding AmountPiastres}" Width="120" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                </TabControl>

                <!-- شريط الحالة -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="0,0,12,12" Padding="14,8">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
