<UserControl x:Class="ePrescriptions.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1100">

    <Grid Background="Transparent">
        <Border Background="White" CornerRadius="12" Margin="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- رأس الشاشة -->
                    <RowDefinition Height="Auto" />
                    <!-- المحتوى الرئيسي بعلامات التبويب -->
                    <RowDefinition Height="*" />
                    <!-- شريط الحالة السفلي -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1) رأس الشاشة -->
                <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" CornerRadius="12,12,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconInventory}" Fill="#A78BFA" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0" />
                            <TextBlock Text="إدارة المخزون والأدوية وتنبيهات الصلاحية (FEFO)" FontSize="20" FontWeight="Bold" Foreground="White" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding RefreshCommand}" Style="{StaticResource PosActionButton}" Background="#3B82F6" Padding="12,6" Margin="4,0">
                                <TextBlock Text="تحديث البيانات" />
                            </Button>
                            <Button Command="{Binding NewItemCommand}" Style="{StaticResource PosActionButton}" Background="#10B981" Padding="12,6" Margin="4,0">
                                <TextBlock Text="+ صنف جديد" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2) المحتوى مع TabControl -->
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10">
                    <!-- التبويب 1: قائمة الأصناف والبحث والبيانات التفصيلية -->
                    <TabItem Header="دليل الأصناف والمخزون" FontSize="14" FontWeight="Bold" Padding="16,8">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.3*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <!-- جدول الأصناف والبحث -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- شريط البحث -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource AppTextBox}" 
                                                 FontSize="14" Padding="32,7,10,7" />
                                        <Path Data="{StaticResource IconSearch}" Fill="#94A3B8" Width="16" Height="16" Stretch="Uniform" 
                                              HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>

                                    <!-- جدول الأصناف Virtualized -->
                                    <DataGrid Grid.Row="1" 
                                              ItemsSource="{Binding ItemsList}" 
                                              SelectedItem="{Binding SelectedItem}"
                                              Style="{StaticResource AppFastDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="90" IsReadOnly="True" />
                                            <DataGridTemplateColumn Header="اسم الصنف الدوائي" Width="*" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                            <TextBlock Text="{Binding NameAr}" FontWeight="Bold" Foreground="#0F172A" />
                                                            <TextBlock Text="{Binding ActiveIngredient}" FontSize="11" Foreground="#64748B" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="سعر البيع" Binding="{Binding FormattedRetailPrice}" Width="90" IsReadOnly="True" />
                                            <DataGridTextColumn Header="سعر التكلفة" Binding="{Binding FormattedCostPrice}" Width="90" IsReadOnly="True" />
                                            <DataGridTemplateColumn Header="رصيد المخزون بالتفصيل" Width="150" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding FormattedStock}" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="{Binding IsLowStock, Converter={x:Null}}" 
                                                                   VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- لوحة تفاصيل وإدخال الصنف المختار -->
                            <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="بيانات الصنف الدوائي ومعاملات التجزئة" FontWeight="Bold" FontSize="14" Foreground="#1E1B4B" Margin="0,0,0,10" />

                                        <TextBlock Text="كود الصنف:" Foreground="#475569" Margin="0,4,0,2" />
                                        <TextBox Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />

                                        <TextBlock Text="الباركود الدولي:" Foreground="#475569" Margin="0,6,0,2" />
                                        <TextBox Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />

                                        <TextBlock Text="الاسم بالعربية:" Foreground="#475569" Margin="0,6,0,2" />
                                        <TextBox Text="{Binding EditNameAr, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" FontWeight="Bold" />

                                        <TextBlock Text="الاسم بالإنجليزية:" Foreground="#475569" Margin="0,6,0,2" />
                                        <TextBox Text="{Binding EditNameEn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />

                                        <TextBlock Text="المادة الفعالة والتركيز:" Foreground="#475569" Margin="0,6,0,2" />
                                        <TextBox Text="{Binding EditActiveIngredient, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="أشرطة في العلبة:" Foreground="#475569" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding EditStripsPerBox, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" TextAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="أقراص في الشريط:" Foreground="#475569" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding EditPiecesPerStrip, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" TextAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="سعر بيع العلبة (ج.م):" Foreground="#475569" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding EditRetailPriceRiyals, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" FontWeight="Bold" TextAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="سعر التكلفة (ج.م):" Foreground="#475569" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding EditCostPriceRiyals, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" TextAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="حد تنبيه قرب النفاد (أصغر وحدة):" Foreground="#475569" Margin="0,8,0,2" />
                                        <TextBox Text="{Binding EditMinStockAlert, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" TextAlignment="Center" />

                                        <CheckBox IsChecked="{Binding EditIsPrescriptionRequired}" Content="يتطلب وصفة طبية (لا يُباع بدون رقم وصفة واسم طبيب)" Margin="0,10,0,0" FontWeight="SemiBold" Foreground="#475569" />

                                        <Button Command="{Binding SaveItemCommand}" Style="{StaticResource PosActionButton}" Background="#4F46E5" Margin="0,14,0,0">
                                            <TextBlock Text="حفظ بيانات الصنف" FontSize="14" />
                                        </Button>

                                        <Button Command="{Binding PrintBarcodeLabelCommand}" Style="{StaticResource PosSecondaryButton}" Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconInventory}" Fill="#4F46E5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock Text="طباعة ملصق الباركود (50×25 مم)" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- التبويب 2: تنبيهات الصلاحية والأصناف القريبة الانتهاء (FEFO) والنواقص -->
                    <TabItem Header="تنبيهات الصلاحية والنواقص" FontSize="14" FontWeight="Bold" Padding="16,8">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- الدفعات القريبة الانتهاء خلال 90 يوماً -->
                            <Border Grid.Column="0" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="دفعات قريبة الانتهاء (خلال 90 يوماً) - FEFO" FontWeight="Bold" Foreground="#B45309" Margin="0,0,0,10" />

                                    <DataGrid Grid.Row="1" ItemsSource="{Binding NearExpiryList}" Style="{StaticResource AppFastDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="الصنف" Binding="{Binding ItemNameAr}" Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="التشغيلة" Binding="{Binding BatchNumber}" Width="90" IsReadOnly="True" />
                                            <DataGridTextColumn Header="الصلاحية" Binding="{Binding FormattedExpiry}" Width="95" IsReadOnly="True" />
                                            <DataGridTextColumn Header="الرصيد" Binding="{Binding RemainingSmallestUnits}" Width="70" IsReadOnly="True" />
                                            <DataGridTextColumn Header="الأيام المتبقية" Binding="{Binding DaysRemaining}" Width="90" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- الأصناف التي أوشكت على النفاد -->
                            <Border Grid.Column="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="الأصناف التي وصلت لحد الطلب (النواقص)" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,10" />

                                    <DataGrid Grid.Row="1" ItemsSource="{Binding LowStockList}" Style="{StaticResource AppFastDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="كود" Binding="{Binding Code}" Width="80" IsReadOnly="True" />
                                            <DataGridTextColumn Header="اسم الصنف" Binding="{Binding NameAr}" Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="الرصيد الحالي" Binding="{Binding TotalStockSmallestUnits}" Width="90" IsReadOnly="True" />
                                            <DataGridTextColumn Header="حد الطلب" Binding="{Binding MinStockAlertSmallestUnits}" Width="80" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- التبويب 3: جرد المخزون الفعلي وتسجيل التسويات -->
                    <TabItem Header="الجرد الفعلي والتسويات" FontSize="14" FontWeight="Bold" Padding="16,8">
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Right">
                                <TextBlock Text="تسوية الجرد المخزني الفعلي ومطابقة الرصيد الدفتري" FontSize="16" FontWeight="Bold" Foreground="#1E1B4B" Margin="0,0,0,14" />

                                <TextBlock Text="الصنف المحدد للجرد:" Foreground="#475569" Margin="0,4,0,2" />
                                <TextBlock Text="{Binding SelectedItem.NameAr, FallbackValue='(يرجى اختيار صنف من جدول الأصناف أولاً)'}" FontWeight="Bold" Foreground="#0F172A" FontSize="15" Margin="0,0,0,10" />

                                <Grid Margin="0,6,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="الرصيد الدفتري الحالي (وحدة):" Foreground="#475569" />
                                        <TextBlock Text="{Binding SelectedItem.TotalStockSmallestUnits, FallbackValue='0'}" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="الرصيد الفعلي بعد العد:" Foreground="#475569" />
                                        <TextBox Text="{Binding ActualStockUnits, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="سبب التسوية وملاحظات الجرد:" Foreground="#475569" Margin="0,6,0,2" />
                                <TextBox Text="{Binding AdjustmentReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="60" AcceptsReturn="True" />

                                <Button Command="{Binding ApplyStockAdjustmentCommand}" Style="{StaticResource PosActionButton}" Background="#059669" Margin="0,16,0,0">
                                    <TextBlock Text="اعتماد تسوية الجرد وتحديث المخزون" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- التبويب 4: إضافة تشغيلة جديدة مباشرة -->
                    <TabItem Header="إضافة دفعة / تشغيلة جديدة" FontSize="14" FontWeight="Bold" Padding="16,8">
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                            <StackPanel MaxWidth="500" HorizontalAlignment="Right">
                                <TextBlock Text="إضافة دفعة جديدة للصنف المحدد" FontSize="16" FontWeight="Bold" Foreground="#1E1B4B" Margin="0,0,0,14" />

                                <TextBlock Text="الصنف المستهدف:" Foreground="#475569" Margin="0,4,0,2" />
                                <TextBlock Text="{Binding SelectedItem.NameAr, FallbackValue='(يرجى اختيار صنف من جدول الأصناف أولاً)'}" FontWeight="Bold" Foreground="#0F172A" FontSize="15" Margin="0,0,0,10" />

                                <TextBlock Text="رقم التشغيلة (Batch Number):" Foreground="#475569" Margin="0,6,0,2" />
                                <TextBox Text="{Binding NewBatchNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />

                                <TextBlock Text="تاريخ الانتهاء:" Foreground="#475569" Margin="0,8,0,2" />
                                <DatePicker SelectedDate="{Binding NewBatchExpiry}" Height="36" />

                                <TextBlock Text="الكمية المضافة (بأصغر وحدة):" Foreground="#475569" Margin="0,8,0,2" />
                                <TextBox Text="{Binding NewBatchSmallestUnits, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" TextAlignment="Center" FontWeight="Bold" />

                                <Button Command="{Binding AddBatchCommand}" Style="{StaticResource PosActionButton}" Background="#2563EB" Margin="0,16,0,0">
                                    <TextBlock Text="حفظ الدفعة وزيادة المخزون" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>

                <!-- 3) شريط الحالة السفلي -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="0,0,12,12" Padding="14,8">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
