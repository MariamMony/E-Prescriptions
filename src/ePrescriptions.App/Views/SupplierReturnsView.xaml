<UserControl x:Class="ePrescriptions.App.Views.SupplierReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:ePrescriptions.Domain.Enums;assembly=ePrescriptions.Domain"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- العنوان والحالة -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="مرتجع / إتلاف الأدوية المنتهية" FontSize="18" FontWeight="Bold" Foreground="#1E1B4B" />
                <TextBlock Text="أرجع التشغيلات المنتهية أو القريبة من الانتهاء للشركة بنسبة خصم، أو اتلفها. الكمية بتتخصم من المخزون وقيمة الاسترداد بتتخصم من رصيد الشركة."
                           Foreground="#64748B" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#4F46E5" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- إعدادات المستند -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="4">
                    <TextBlock Text="الشركة (المورد):" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name"
                              IsEnabled="{Binding IsReturnToSupplier}" Style="{StaticResource AppComboBox}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="نسبة خصم الشركة %:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DeductionPercent, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsReturnToSupplier}" Style="{StaticResource AppTextBox}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="4" VerticalAlignment="Bottom">
                    <CheckBox Content="إتلاف (بدون استرداد)" IsChecked="{Binding IsDestroy}" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,0,0,8" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="4">
                    <TextBlock Text="عرض اللي بينتهي خلال (يوم):" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="70" Text="{Binding WithinDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        <Button Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource PosSecondaryButton}" Margin="6,0,0,0" Padding="12,6" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="4">
                    <TextBlock Text="السبب:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding Reason}" Style="{StaticResource AppComboBox}" />
                </StackPanel>

                <StackPanel Grid.Column="5" Margin="4">
                    <TextBlock Text="ملاحظات:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- الجدولان: التشغيلات المتاحة + بنود المستند -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,6">
                        <TextBlock Text="تشغيلات منتهية / قريبة الانتهاء" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                        <Button Content="إضافة كل المنتهي" Command="{Binding AddAllExpiredCommand}" HorizontalAlignment="Left" Style="{StaticResource PosSecondaryButton}" Padding="12,5" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Candidates}" Style="{StaticResource AppFastDataGrid}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*" />
                            <DataGridTextColumn Header="التشغيلة" Binding="{Binding BatchNumber}" Width="80" />
                            <DataGridTextColumn Header="الصلاحية" Binding="{Binding ExpiryText}" Width="90" />
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="110" />
                            <DataGridTextColumn Header="المتاح" Binding="{Binding RemainingText}" Width="110" />
                            <DataGridTextColumn Header="قيمة التكلفة" Binding="{Binding CostValueText}" Width="95" />
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="إضافة" Padding="10,3"
                                                Command="{Binding DataContext.AddToReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="بنود المستند" FontWeight="Bold" Foreground="#1E293B" Margin="4,0,4,6" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" Style="{StaticResource AppFastDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="التشغيلة" Binding="{Binding BatchNumber}" Width="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="المتاح" Binding="{Binding AvailableText}" Width="100" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="الوحدة" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding UnitLevel, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Height="28">
                                            <ComboBoxItem Content="علبة" Tag="{x:Static enums:UnitLevel.Box}" />
                                            <ComboBoxItem Content="شريط" Tag="{x:Static enums:UnitLevel.Strip}" />
                                            <ComboBoxItem Content="قرص" Tag="{x:Static enums:UnitLevel.Piece}" />
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                            <DataGridTextColumn Header="خصم %" Binding="{Binding DeductionPercent, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                            <DataGridTextColumn Header="التكلفة" Binding="{Binding CostText}" Width="85" IsReadOnly="True" />
                            <DataGridTextColumn Header="الاسترداد" Binding="{Binding CreditText}" Width="85" IsReadOnly="True" />
                            <DataGridTextColumn Header="تنبيه" Binding="{Binding ErrorText}" Width="120" IsReadOnly="True" Foreground="#DC2626" />
                            <DataGridTemplateColumn Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="حذف" Padding="8,3"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- المجاميع والحفظ -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="16,10" Margin="0,10,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="إجمالي التكلفة: " Foreground="#64748B" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalCostText}" FontWeight="Bold" Margin="0,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="الاسترداد: " Foreground="#64748B" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CreditText}" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="الخسارة: " Foreground="#64748B" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LossText}" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="حفظ المستند وخصم المخزون" Command="{Binding SaveCommand}" HorizontalAlignment="Left"
                        Style="{StaticResource PosActionButton}" Background="#DC2626" Foreground="White" Padding="20,8" />
            </Grid>
        </Border>

        <!-- آخر المستندات -->
        <Border Grid.Row="4" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
            <DataGrid ItemsSource="{Binding History}" Style="{StaticResource AppFastDataGrid}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم المستند" Binding="{Binding ReturnNumber}" Width="140" />
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding DateText}" Width="130" />
                    <DataGridTextColumn Header="النوع" Binding="{Binding KindText}" Width="100" />
                    <DataGridTextColumn Header="السبب" Binding="{Binding ReasonText}" Width="120" />
                    <DataGridTextColumn Header="الشركة" Binding="{Binding PartyText}" Width="*" />
                    <DataGridTextColumn Header="التكلفة" Binding="{Binding CostText}" Width="100" />
                    <DataGridTextColumn Header="الاسترداد" Binding="{Binding CreditText}" Width="100" />
                    <DataGridTextColumn Header="الخسارة" Binding="{Binding LossText}" Width="100" />
                    <DataGridTextColumn Header="بواسطة" Binding="{Binding UserName}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
