<UserControl x:Class="ePrescriptions.App.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:enums="clr-namespace:ePrescriptions.Domain.Enums;assembly=ePrescriptions.Domain"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <!-- الحاوية الرئيسية البيضاء بزوايا دائرية وظل خفيف واحد فقط -->
        <Border Background="White" CornerRadius="12" Margin="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- رأس شاشة المبيعات وشريط الحالة -->
                    <RowDefinition Height="Auto" />
                    <!-- بيانات العميل والوصفة الطبية -->
                    <RowDefinition Height="Auto" />
                    <!-- حقل البحث والأصناف الأكثر طلباً -->
                    <RowDefinition Height="Auto" />
                    <!-- جدول بنود الفاتورة الرئيسي (DataGrid Virtualized) -->
                    <RowDefinition Height="*" />
                    <!-- شريط المجاميع وصافي المستحق -->
                    <RowDefinition Height="Auto" />
                    <!-- شريط أزرار الاختصارات الوظيفية (F1..F10) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1) رأس الشاشة: تدرج أنيق مع شريط شفاف للمعلومات -->
                <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" CornerRadius="12,12,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- العنوان ونوع الفاتورة -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSales}" Fill="#38BDF8" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding InvoiceTypeTitle}" FontSize="20" FontWeight="Bold" Foreground="White" />
                        </StackPanel>

                        <!-- الشريط الشفاف: رقم الفاتورة، التاريخ والوقت، المستخدم -->
                        <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="6" Padding="12,6" Margin="20,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="رقم الفاتورة: " Foreground="#94A3B8" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding InvoiceNumber}" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,16,0" />
                                <TextBlock Text=" | " Foreground="#475569" Margin="0,0,16,0" />
                                <TextBlock Text="المستخدم: " Foreground="#94A3B8" FontWeight="SemiBold" />
                                <TextBlock Text="ماجد القبانى" Foreground="White" FontWeight="Bold" />
                            </StackPanel>
                        </Border>

                        <!-- إشعار الحالة اللحظية -->
                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="12,6">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 2) بيانات العميل والوصفة الطبية وطريقة الدفع -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>

                        <!-- اسم العميل -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                            <TextBlock Text="اسم العميل:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        </StackPanel>

                        <!-- جوال العميل -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                            <TextBlock Text="رقم الجوال:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        </StackPanel>

                        <!-- فئة السعر (قطاعي / جملة) -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                            <TextBlock Text="فئة السعر:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <ComboBox SelectedValue="{Binding SelectedPriceCategory}" SelectedValuePath="Tag" Style="{StaticResource AppComboBox}">
                                <ComboBoxItem Content="قطاعي" Tag="{x:Static enums:PriceCategory.Retail}" IsSelected="True" />
                                <ComboBoxItem Content="جملة" Tag="{x:Static enums:PriceCategory.Wholesale}" />
                            </ComboBox>
                        </StackPanel>

                        <!-- طريقة الدفع -->
                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="4">
                            <TextBlock Text="طريقة الدفع:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <ComboBox SelectedValue="{Binding SelectedPaymentMethod}" SelectedValuePath="Tag" Style="{StaticResource AppComboBox}">
                                <ComboBoxItem Content="نقدي (Cash)" Tag="{x:Static enums:PaymentMethod.Cash}" IsSelected="True" />
                                <ComboBoxItem Content="شبكة / مدى" Tag="{x:Static enums:PaymentMethod.Network}" />
                                <ComboBoxItem Content="آجل (على الحساب)" Tag="{x:Static enums:PaymentMethod.OnAccount}" />
                                <ComboBoxItem Content="تأمين طبي" Tag="{x:Static enums:PaymentMethod.Insurance}" />
                            </ComboBox>
                        </StackPanel>

                        <!-- رقم الوصفة الإلكترونية -->
                        <StackPanel Grid.Row="0" Grid.Column="4" Margin="4">
                            <TextBlock Text="رقم الوصفة (Rx):" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PrescriptionNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        </StackPanel>

                        <!-- اسم الطبيب المعالج -->
                        <StackPanel Grid.Row="0" Grid.Column="5" Margin="4">
                            <TextBlock Text="اسم الطبيب:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DoctorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6">
                        <!-- لا بيع بدون وردية مفتوحة -->
                        <Border Margin="4,8,4,0" Padding="12,8" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8"
                                Visibility="{Binding NoOpenShift, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="لا توجد وردية مفتوحة — افتح وردية عشان تبدأ البيع. رصيد الافتتاح (ج.م):" FontWeight="Bold" Foreground="#B91C1C" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Width="100" Style="{StaticResource AppTextBox}" Text="{Binding OpeningBalancePounds, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Command="{Binding OpenShiftCommand}" Style="{StaticResource PosActionButton}" Background="#DC2626" Margin="8,0,0,0" Padding="16,6">
                                    <TextBlock Text="فتح وردية" Foreground="White" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- مرتجع المبيعات: رقم فاتورة البيع الأصلية (يظهر في وضع المرتجع فقط) -->
                        <Border Margin="4,8,4,0" Padding="12,8"
                                Background="#F5F3FF" BorderBrush="#C4B5FD" BorderThickness="1" CornerRadius="8"
                                Visibility="{Binding IsReturnMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="رقم فاتورة البيع الأصلية:" FontWeight="Bold" Foreground="#6D28D9" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Width="220" Style="{StaticResource AppTextBox}"
                                         Text="{Binding OriginalInvoiceNumber, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding LoadOriginalInvoiceCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Command="{Binding LoadOriginalInvoiceCommand}" Style="{StaticResource PosActionButton}" Background="#8B5CF6" Margin="8,0,0,0" Padding="16,6">
                                    <TextBlock Text="تحميل الفاتورة" Foreground="White" />
                                </Button>
                                <TextBlock Text="الأصناف والأسعار بتيجي من الفاتورة الأصلية، عدّل الكمية أو احذف البند اللي مش راجع."
                                           Foreground="#7C3AED" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3) البحث الفوري وشريط الأصناف الأكثر طلباً -->
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- حقل البحث المباشر والباركود مع زر الإدخال -->
                            <Grid Grid.Column="0" Margin="4,0,8,0">
                                <TextBox x:Name="SearchInputBox"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource AppTextBox}" 
                                         FontSize="15" Padding="36,8,12,8">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding BarcodeEnterCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Path Data="{StaticResource IconSearch}" Fill="#94A3B8" Width="18" Height="18" 
                                      Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>

                            <Button Grid.Column="1" Command="{Binding BarcodeEnterCommand}" Style="{StaticResource PosActionButton}" Background="#0284C7" Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBarcode}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="إضافة بالباركود (Enter)" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- شريط الأزرار السريعة للأصناف الأكثر مبيعاً -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8,4,0">
                            <TextBlock Text="الأكثر طلباً:" Foreground="#64748B" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ItemsControl ItemsSource="{Binding TopSellingItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.AddItemToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#EEF2F6" BorderBrush="#CBD5E1" BorderThickness="1"
                                                Margin="0,0,6,4" Padding="10,5" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="{Binding NameAr}" FontSize="12" Foreground="#1E293B" FontWeight="SemiBold" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4) جدول بنود الفاتورة الديناميكي (DataGrid مع Virtualization) -->
                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding CartItems}"
                          Style="{StaticResource AppFastDataGrid}"
                          Margin="10,8">
                    <DataGrid.Columns>
                        <!-- كود الصنف -->
                        <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="100" IsReadOnly="True" />

                        <!-- اسم الصنف العربي -->
                        <DataGridTemplateColumn Header="اسم الصنف الدوائي والمادة الفعالة" Width="2*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="6,2">
                                        <TextBlock Text="{Binding NameAr}" FontWeight="Bold" Foreground="#0F172A" />
                                        <TextBlock Text="{Binding ActiveIngredient}" FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- وحدة البيع (علبة / شريط / قرص) -->
                        <DataGridTemplateColumn Header="الوحدة" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValue="{Binding SelectedUnitLevel, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Height="30">
                                        <ComboBoxItem Content="علبة" Tag="{x:Static enums:UnitLevel.Box}" />
                                        <ComboBoxItem Content="شريط" Tag="{x:Static enums:UnitLevel.Strip}" />
                                        <ComboBoxItem Content="قرص" Tag="{x:Static enums:UnitLevel.Piece}" />
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الكمية المباعة -->
                        <DataGridTemplateColumn Header="الكمية" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                             FontWeight="Bold" TextAlignment="Center" Height="30" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- سعر الوحدة بالجنيه -->
                        <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding FormattedUnitPrice}" Width="95" IsReadOnly="True" />

                        <!-- الخصم بالهللات -->
                        <DataGridTemplateColumn Header="الخصم (هللة)" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DiscountPiastres, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Height="30" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ضريبة 15% -->
                        <DataGridTextColumn Header="الضريبة 15%" Binding="{Binding FormattedVat}" Width="90" IsReadOnly="True" />

                        <!-- رصيد المخزون مع التنبيه -->
                        <DataGridTemplateColumn Header="رصيد المخزون" Width="120" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="4" Padding="5,2" Background="{Binding IsLowStock, Converter={x:Null}}">
                                            <TextBlock Text="{Binding FormattedStockDisplay}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- التشغيلة والصلاحية -->
                        <DataGridTextColumn Header="التشغيلة" Binding="{Binding BatchNumber}" Width="95" IsReadOnly="True" />
                        <DataGridTextColumn Header="الصلاحية" Binding="{Binding FormattedExpiry}" Width="95" IsReadOnly="True" />
                        <DataGridTextColumn Header="تنبيه" Binding="{Binding WarningText}" Width="260" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#DC2626" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- الإجمالي -->
                        <DataGridTemplateColumn Header="الإجمالي" Width="105" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedTotal}" FontWeight="Bold" Foreground="#1E1B4B" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- زر حذف البند -->
                        <DataGridTemplateColumn Header="حذف" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#FEE2E2" BorderThickness="0" Cursor="Hand" Width="30" Height="30">
                                        <Path Data="{StaticResource IconTrash}" Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 5) شريط المجاميع وصافي المستحق والمدفوع والمتبقي -->
                <Border Grid.Row="4" Background="#F1F5F9" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,1" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- تفاصيل إحصائية سريعة -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="عدد الأصناف: " Foreground="#64748B" FontWeight="Bold" />
                            <TextBlock Text="{Binding CartItems.Count}" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,16,0" />
                        </StackPanel>

                        <!-- المجموع الفرعي -->
                        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,6" Margin="6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="المجموع قبل الضريبة" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SubtotalRiyals, StringFormat='{}{0:N2} ج.م'}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- إجمالي الضريبة 15% -->
                        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,6" Margin="6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ضريبة القيمة المضافة (15%)" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding VatRiyals, StringFormat='{}{0:N2} ج.م'}" FontSize="15" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- تمييز صافي المستحق الإجمالي بشكل بارز -->
                        <Border Grid.Column="3" Background="#1E1B4B" CornerRadius="8" Padding="20,6" Margin="6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="صافي المستحق (Net)" FontSize="12" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding TotalNetRiyals, StringFormat='{}{0:N2} ج.م'}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- المبلغ المدفوع -->
                        <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="المدفوع:" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                                <TextBox Text="{Binding PaidRiyals, StringFormat='{}{0:N2}', UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="16" FontWeight="Bold" TextAlignment="Center" Width="90" BorderThickness="0" Background="Transparent" />
                            </StackPanel>
                        </Border>

                        <!-- المتبقي / مديونية -->
                        <Border Grid.Column="5" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="14,6" Margin="6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="المتبقي / آجل" FontSize="11" Foreground="#DC2626" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding RemainingRiyals, StringFormat='{}{0:N2} ج.م'}" FontSize="16" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 6) شريط أزرار الاختصارات الوظيفية (F1, F2, F3, F4, F8, F9, F10) -->
                <Border Grid.Row="5" Background="#1E293B" CornerRadius="0,0,12,12" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- مجموعة الأزرار السريعة -->
                        <WrapPanel Grid.Column="0" Orientation="Horizontal">
                            <!-- F1: جديد -->
                            <Button Command="{Binding NewInvoiceCommand}" Style="{StaticResource PosActionButton}" Background="#3B82F6" Margin="4,2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1D4ED8" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                        <TextBlock Text="F1" Foreground="White" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Text="فاتورة جديدة" />
                                </StackPanel>
                            </Button>

                            <!-- F2: حفظ الفاتورة -->
                            <Button Command="{Binding SaveInvoiceCommand}" Style="{StaticResource PosActionButton}" Background="#10B981" Margin="4,2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#047857" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                        <TextBlock Text="F2" Foreground="White" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Text="حفظ الفاتورة" />
                                </StackPanel>
                            </Button>

                            <!-- F3: طباعة -->
                            <Button Command="{Binding PrintInvoiceCommand}" Style="{StaticResource PosActionButton}" Background="#6366F1" Margin="4,2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#4338CA" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                        <TextBlock Text="F3" Foreground="White" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Text="طباعة إيصال" />
                                </StackPanel>
                            </Button>

                            <!-- F8: تعليق الفاتورة -->
                            <Button Command="{Binding SuspendInvoiceCommand}" Style="{StaticResource PosActionButton}" Background="#F59E0B" Margin="4,2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#B45309" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                        <TextBlock Text="F8" Foreground="White" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Text="تعليق الفاتورة" />
                                </StackPanel>
                            </Button>

                            <!-- F9: مرتجع -->
                            <Button Command="{Binding ToggleReturnModeCommand}" Style="{StaticResource PosActionButton}" Background="#8B5CF6" Margin="4,2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#6D28D9" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                        <TextBlock Text="F9" Foreground="White" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Text="وضع المرتجع" />
                                </StackPanel>
                            </Button>

                            <!-- F10: فتح الدرج -->
                            <Button Command="{Binding OpenCashDrawerCommand}" Style="{StaticResource PosActionButton}" Background="#475569" Margin="4,2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#334155" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                        <TextBlock Text="F10" Foreground="White" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Text="فتح الدرج" />
                                </StackPanel>
                            </Button>

                            <!-- F11: إلغاء فاتورة (Admin/Owner فقط) -->
                            <Button Command="{Binding CancelInvoiceCommand}" Style="{StaticResource PosActionButton}" Background="#DC2626" Margin="4,2"
                                    Visibility="{Binding CanCancelInvoice, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#991B1B" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                        <TextBlock Text="F11" Foreground="White" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Text="إلغاء فاتورة" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
