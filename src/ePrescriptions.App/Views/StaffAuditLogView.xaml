<UserControl x:Class="ePrescriptions.App.Views.StaffAuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="سجل نشاط الموظفين" FontSize="18" FontWeight="Bold" Foreground="#1E1B4B" />
                    <TextBlock Text="تعديلات المدير والصيدلي والكاشير على الأصناف وبيانات العملاء." Foreground="#64748B" FontSize="12" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#4F46E5" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource PosSecondaryButton}" Padding="16,8" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
            <DataGrid ItemsSource="{Binding Entries}" Style="{StaticResource AppFastDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding FormattedDate}" Width="140" />
                    <DataGridTextColumn Header="الموظف" Binding="{Binding ActorUserName}" Width="140" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="الدور" Binding="{Binding ActorRole}" Width="100" />
                    <DataGridTextColumn Header="العنصر" Binding="{Binding EntityLabel}" Width="180" />
                    <DataGridTextColumn Header="الحقل المعدَّل" Binding="{Binding FieldName}" Width="160" />
                    <DataGridTextColumn Header="القيمة قبل" Binding="{Binding OldValue}" Width="120" Foreground="#DC2626" />
                    <DataGridTextColumn Header="القيمة بعد" Binding="{Binding NewValue}" Width="120" Foreground="#16A34A" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
