<UserControl x:Class="ePrescriptions.App.Views.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:ePrescriptions.Domain.Enums;assembly=ePrescriptions.Domain"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}">

    <Grid Background="Transparent">
        <Border Background="White" CornerRadius="12" Margin="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- رأس الشاشة -->
                    <RowDefinition Height="Auto" />
                    <!-- المحتوى الرئيسي -->
                    <RowDefinition Height="*" />
                    <!-- شريط الحالة -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- رأس الشاشة -->
                <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" CornerRadius="12,12,0,0" Padding="16,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconStaff}" Fill="#818CF8" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0" />
                        <TextBlock Text="إدارة الموظفين والورديات وتسليم الصندوق والعهدة" FontSize="20" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Border>

                <!-- المحتوى: لوحة الوردية يميناً + قائمة الموظفين يساراً -->
                <Grid Grid.Row="1" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <!-- لوحة الوردية وإغلاق الصندوق -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="إدارة الوردية الحالية والصندوق النقدي" FontWeight="Bold" FontSize="16" Foreground="#1E1B4B" Margin="0,0,0,14" />

                                <!-- بطاقات إحصائية للوردية الحالية -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="الرصيد الافتتاحي" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{Binding FormattedOpeningBalance}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="مبيعات الوردية نقداً" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{Binding FormattedCashSales}" FontSize="15" FontWeight="Bold" Foreground="#10B981" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#1E1B4B" CornerRadius="8" Padding="10" Margin="4,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="النقد المتوقع بالدرج" FontSize="11" Foreground="#38BDF8" FontWeight="Bold" />
                                            <TextBlock Text="{Binding FormattedExpectedCash}" FontSize="16" FontWeight="Bold" Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- إغلاق الوردية وتسليم الصندوق -->
                                <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="تسليم الصندوق وإغلاق الوردية" FontWeight="Bold" FontSize="15" Foreground="#92400E" Margin="0,0,0,10" />

                                        <TextBlock Text="المبلغ الفعلي المعدود في الدرج (ج.م):" Foreground="#78350F" />
                                        <TextBox Text="{Binding ActualClosingCashPounds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" FontWeight="Bold" FontSize="18" TextAlignment="Center" Margin="0,4,0,8" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="الفارق (عجز / زيادة):" Foreground="#78350F" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding ShiftDifferencePounds, StringFormat='{}{0:N2} ج.م'}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Foreground="#DC2626" />
                                        </Grid>

                                        <TextBlock Text="ملاحظات التسليم ونقل العهدة:" Foreground="#78350F" />
                                        <TextBox Text="{Binding ClosingNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="45" Margin="0,4,0,12" />

                                        <Button Command="{Binding CloseShiftCommand}" Style="{StaticResource PosActionButton}" Background="#D97706">
                                            <TextBlock Text="إغلاق الوردية واعتماد التسليم" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- فتح وردية جديدة -->
                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="فتح وردية جديدة" FontWeight="Bold" FontSize="14" Foreground="#065F46" Margin="0,0,0,8" />
                                        <TextBlock Text="الرصيد الافتتاحي للصندوق (ج.م):" Foreground="#047857" />
                                        <TextBox Text="{Binding NewOpeningBalancePounds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,10" />
                                        <Button Command="{Binding OpenShiftCommand}" Style="{StaticResource PosActionButton}" Background="#059669">
                                            <TextBlock Text="بدء وردية جديدة" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- قائمة الموظفين وإضافة موظف -->
                    <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="دليل الموظفين وصلاحيات الدخول" FontWeight="Bold" FontSize="15" Foreground="#1E1B4B" Margin="0,0,0,10" />

                            <DataGrid Grid.Row="1" ItemsSource="{Binding UsersList}" Style="{StaticResource AppFastDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="100" IsReadOnly="True" />
                                    <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="90" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- استمارة موظف جديد -->
                            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                <TextBlock Text="إضافة موظف جديد (كلمة مرور مشفرة PBKDF2):" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6" />
                                <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Margin="0,2,0,4" />
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="1" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Margin="4,0,0,0" />
                                </Grid>
                                <Button Command="{Binding AddUserCommand}" Style="{StaticResource PosActionButton}" Background="#4F46E5" Margin="0,6,0,0">
                                    <TextBlock Text="+ حفظ الموظف" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- شريط الحالة -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="0,0,12,12" Padding="14,8">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
