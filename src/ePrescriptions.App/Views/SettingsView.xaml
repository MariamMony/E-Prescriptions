<UserControl x:Class="ePrescriptions.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- 1) الشريط العلوي مع زر الحفظ -->
            <RowDefinition Height="Auto" />
            <!-- 2) التبويبات والمحتوى الرئيسي -->
            <RowDefinition Height="*" />
            <!-- 3) شريط الحالة السفلي -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1) ترويسة الشاشة وزر الحفظ -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="إعدادات النظام والملحقات" FontSize="18" FontWeight="Bold" Foreground="#1E1B4B" />
                    <TextBlock Text="تخصيص بيانات الصيدلية، الطابعات، درج النقدية، وإدارة النسخ الاحتياطي" Foreground="#64748B" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PosActionButton}" Background="#4F46E5" Height="38" Padding="20,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSettings}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="حفظ جميع الإعدادات" FontWeight="Bold" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 2) تبويبات الإعدادات -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
            <TabControl BorderThickness="0" Background="Transparent">
                <!-- تبويب 1: بيانات المنشأة والصيدلية -->
                <TabItem Header="بيانات الصيدلية والضريبة" FontSize="14" FontWeight="SemiBold">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="10,16,10,10">
                            <!-- الاسم بالعربي -->
                            <TextBlock Text="اسم الصيدلية (باللغة العربية):" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PharmacyNameAr, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="36" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

                            <!-- الاسم بالإنجليزي -->
                            <TextBlock Text="اسم الصيدلية (باللغة الإنجليزية):" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PharmacyNameEn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="36" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- الرقم الضريبي -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="الرقم الضريبي للمنشأة:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="36" FontWeight="SemiBold" />
                                </StackPanel>

                                <!-- السجل التجاري -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="رقم السجل التجاري:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding CommercialRegister, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="36" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- رقم ترخيص الصيدلية -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="رقم ترخيص مزاولة المهنة:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding LicenseNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="36" />
                                </StackPanel>

                                <!-- الهاتف -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="رقم هاتف / جوال الصيدلية:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="36" />
                                </StackPanel>
                            </Grid>

                            <!-- العنوان -->
                            <TextBlock Text="العنوان وموقع الصيدلية:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="36" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- نسبة الضريبة الافتراضية -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="نسبة ضريبة القيمة المضافة الافتراضية (%):" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding DefaultVatPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="36" FontWeight="Bold" />
                                </StackPanel>

                                <!-- العملة الأساسية -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="العملة الرسمية للنظام:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding CurrencyDisplay}" Style="{StaticResource AppTextBox}" Height="36" IsReadOnly="True" Background="#F1F5F9" FontWeight="Bold" Foreground="#0F172A" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- تبويب 2: إعدادات الطابعات -->
                <TabItem Header="الطابعات وأبعاد الورق" FontSize="14" FontWeight="SemiBold">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="10,16,10,10">
                            <!-- طابعة الإيصالات الحرارية -->
                            <TextBlock Text="طابعة الإيصالات الحرارية (كاشير 80mm):" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding InstalledPrinters}" SelectedItem="{Binding ReceiptPrinterName, Mode=TwoWay}" Height="36" Margin="0,0,0,6" />
                            <TextBlock Text="الطابعة المستخدمة لطباعة فواتير البيع الفورية ورمز الاستجابة السريع ZATCA QR." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,14" />

                            <!-- طابعة التقارير والفواتير A4 -->
                            <TextBlock Text="طابعة التقارير وفواتير الشراء (A4):" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding InstalledPrinters}" SelectedItem="{Binding A4PrinterName, Mode=TwoWay}" Height="36" Margin="0,0,0,6" />
                            <TextBlock Text="طابعة المستندات الرسمية وكشوف الحسابات الضريبية." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,14" />

                            <!-- طابعة ملصقات الباركود -->
                            <TextBlock Text="طابعة ملصقات الباركود (Barcode Labels):" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding InstalledPrinters}" SelectedItem="{Binding LabelPrinterName, Mode=TwoWay}" Height="36" Margin="0,0,0,6" />
                            <TextBlock Text="طابعة استيكرات الأسعار والباركود اللاصق على العلب والأدوية." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,16" />

                            <!-- أبعاد الورق والملصقات -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="عرض ورق الإيصال (مم):" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ReceiptPaperWidthMm}" Style="{StaticResource AppTextBox}" Height="34" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="عرض الاستيكر (مم):" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding LabelWidthMm}" Style="{StaticResource AppTextBox}" Height="34" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="ارتفاع الاستيكر (مم):" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding LabelHeightMm}" Style="{StaticResource AppTextBox}" Height="34" />
                                </StackPanel>
                            </Grid>

                            <!-- زر تجربة الطابعة -->
                            <Button Command="{Binding TestReceiptPrinterCommand}" Style="{StaticResource PosSecondaryButton}" Height="36" Padding="16,0" HorizontalAlignment="Left">
                                <TextBlock Text="طباعة تذكرة اختبارية على طابعة الكاشير" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- تبويب 3: درج النقود وقارئ الباركود -->
                <TabItem Header="درج النقود والباركود" FontSize="14" FontWeight="SemiBold">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="10,16,10,10">
                            <!-- فتح الدرج التلقائي -->
                            <CheckBox IsChecked="{Binding EnableCashDrawerOnPrint, Mode=TwoWay}" Margin="0,0,0,12">
                                <TextBlock Text="فتح درج النقدية تلقائياً عند حفظ وطباعة كل فاتورة نقدية" FontWeight="SemiBold" FontSize="13" Foreground="#1E1B4B" />
                            </CheckBox>

                            <!-- كود نبضة ESC/POS للدرج -->
                            <TextBlock Text="شفرة نبضة فتح الدرج (ESC/POS Bytes مفصولة بفواصل):" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding CashDrawerEscPosBytes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="36" Margin="0,0,0,6" />
                            <TextBlock Text="الكود القياسي لمعظم طابعات إبسون والمتوافقة هو: 27,112,0,25,250" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,14" />

                            <!-- زر تجربة الدرج -->
                            <Button Command="{Binding TestCashDrawerCommand}" Style="{StaticResource PosSecondaryButton}" Height="36" Padding="16,0" HorizontalAlignment="Left" Margin="0,0,0,20">
                                <TextBlock Text="إرسال نبضة تجريبية لفتح الدرج فوراً" />
                            </Button>

                            <Separator Margin="0,0,0,16" Background="#E2E8F0" />

                            <!-- قارئ الباركود -->
                            <TextBlock Text="عتبة التمييز لقارئ الباركود (مللي ثانية):" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding BarcodeScanThresholdMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="36" Margin="0,0,0,6" />
                            <TextBlock Text="القارئ الليزري يرسل المفاتيح بسرعة فائقة تقل عن 50 مللي ثانية للتفريق بين القارئ والكتابة اليدوية." Foreground="#94A3B8" FontSize="11" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- تبويب 4: النسخ الاحتياطي واستعادة البيانات -->
                <TabItem Header="النسخ الاحتياطي والاستعادة" FontSize="14" FontWeight="SemiBold">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="10,16,10,10">
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="إدارة قاعدة البيانات المحلية (SQLite)" FontWeight="Bold" Foreground="#1E40AF" FontSize="14" Margin="0,0,0,4" />
                                    <TextBlock Text="البرنامج يعمل محلياً 100% بدون إنترنت. يتم حفظ جميع البيانات، الفواتير، المخزون، والقيود في ملف SQLite محمي داخل مجلد AppData. يوصى بأخذ نسخة احتياطية دورياً على قرص خارجي أو فلاشة." Foreground="#1E3A8A" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- مسار مجلد النسخ الاحتياطي -->
                            <TextBlock Text="مجلد حفظ النسخ الاحتياطية:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="36" Margin="0,0,0,6" />
                            <!-- نسخة ثانية على قرص/USB منفصل -->
                            <TextBlock Text="نسخة إضافية على قرص / USB منفصل (اتركه فارغاً لتعطيلها):" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ExternalBackupFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="36" Margin="0,0,0,10" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="عدد النسخ المحتفظ بها (الأقدم يُحذف تلقائياً):" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Text="{Binding BackupRetentionCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Width="70" Height="32" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding AutoBackupAfterShift}" Content="أخذ نسخة احتياطية تلقائية بعد إغلاق كل وردية" Foreground="#475569" Margin="0,0,0,8" />
                            <Button Command="{Binding SaveBackupSettingsCommand}" Style="{StaticResource PosSecondaryButton}" Height="32" Padding="14,0" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="حفظ إعدادات النسخ" FontWeight="Bold" />
                            </Button>
                            <TextBlock Text="{Binding LastBackupInfo}" Foreground="#059669" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,16" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <!-- أخذ نسخة احتياطية فورية -->
                                <Button Command="{Binding CreateBackupCommand}" Style="{StaticResource PosActionButton}" Background="#0284C7" Height="38" Padding="18,0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSettings}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="إنشاء نسخة احتياطية فورية الآن" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>

                                <!-- استعادة نسخة احتياطية -->
                                <Button Command="{Binding RestoreBackupCommand}" Style="{StaticResource PosSecondaryButton}" Height="38" Padding="18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="استعادة قاعدة بيانات سابقة (.db)" FontWeight="Bold" Foreground="#DC2626" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12">
                                <TextBlock Text="تنبيه: استعادة نسخة احتياطية سابقة ستقوم باستبدال كافة البيانات الحالية. يتم فحص سلامة الملف تلقائياً قبل الاستبدال، ولو النسخة أقدم من البرنامج تُطبَّق عليها التحديثات الناقصة تلقائياً." Foreground="#991B1B" FontSize="11" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 3) شريط الحالة السفلي -->
        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="12,6" Margin="0,8,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
