<UserControl x:Class="ePrescriptions.App.Views.OwnerLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ترويسة الشاشة: هذه الشاشة لا تُضاف إلى شريط التنقل إلا لحساب صاحب الصيدلية فقط -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="سجل نشاطي" FontSize="18" FontWeight="Bold" Foreground="#1E1B4B" />
                    <TextBlock Text="هذا السجل مرئي لحسابك فقط، ولا يظهر لأي مستخدم آخر مهما كانت صلاحياته." Foreground="#64748B" FontSize="12" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#4F46E5" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource PosSecondaryButton}" Padding="16,8" />
            </Grid>
        </Border>

        <!-- المحتوى: جدول التعديلات + تغيير كلمة المرور -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8" Margin="0,0,10,0">
                <DataGrid ItemsSource="{Binding Entries}" Style="{StaticResource AppFastDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding FormattedDate}" Width="150" />
                        <DataGridTextColumn Header="العنصر" Binding="{Binding EntityLabel}" Width="220" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="الحقل المعدَّل" Binding="{Binding FieldName}" Width="180" />
                        <DataGridTextColumn Header="القيمة قبل" Binding="{Binding OldValue}" Width="140" Foreground="#DC2626" />
                        <DataGridTextColumn Header="القيمة بعد" Binding="{Binding NewValue}" Width="140" Foreground="#16A34A" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- تغيير كلمة المرور -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                <StackPanel>
                    <TextBlock Text="تغيير كلمة المرور" FontWeight="Bold" FontSize="14" Foreground="#1E1B4B" Margin="0,0,0,10" />

                    <TextBlock Text="كلمة المرور الحالية" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                    <PasswordBox x:Name="PwdCurrent" Height="34" Margin="0,0,0,8" Padding="6"
                                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                 PasswordChanged="PwdCurrent_PasswordChanged" />

                    <TextBlock Text="كلمة المرور الجديدة (٨ أحرف على الأقل)" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                    <PasswordBox x:Name="PwdNew" Height="34" Margin="0,0,0,8" Padding="6"
                                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                 PasswordChanged="PwdNew_PasswordChanged" />

                    <TextBlock Text="تأكيد كلمة المرور الجديدة" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                    <PasswordBox x:Name="PwdConfirm" Height="34" Margin="0,0,0,12" Padding="6"
                                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                 PasswordChanged="PwdConfirm_PasswordChanged" />

                    <Button Content="تغيير كلمة المرور" Command="{Binding ChangePasswordCommand}" Style="{StaticResource PosActionButton}" Padding="10" />

                    <TextBlock Text="{Binding PasswordStatusMessage}" TextWrapping="Wrap" Foreground="#DC2626" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
