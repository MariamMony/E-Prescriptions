<UserControl x:Class="ePrescriptions.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 1) شريط الفلترة والأزرار العلوية -->
            <RowDefinition Height="Auto" />
            <!-- 2) كروت المؤشرات المالية السريعة -->
            <RowDefinition Height="Auto" />
            <!-- 3) محتوى التقرير وجداوله التفاعلية -->
            <RowDefinition Height="*" />
            <!-- 4) شريط الحالة السفلي -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1) شريط الفلترة والخيارات -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- من تاريخ -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="من:" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="130" Height="34" />
                    </StackPanel>

                    <!-- إلى تاريخ -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="إلى:" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="130" Height="34" />
                    </StackPanel>

                    <!-- طريقة الدفع -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="طريقة الدفع:" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox SelectedIndex="{Binding SelectedPaymentMethodIndex, Mode=TwoWay}" Width="120" Height="34">
                            <ComboBoxItem Content="الكل" />
                            <ComboBoxItem Content="نقدي" />
                            <ComboBoxItem Content="شبكة / فيزا" />
                            <ComboBoxItem Content="آجل" />
                            <ComboBoxItem Content="تأمين" />
                        </ComboBox>
                    </StackPanel>

                    <!-- أزرار الفلترة السريعة -->
                    <Button Command="{Binding FilterTodayCommand}" Content="اليوم" Style="{StaticResource PosSecondaryButton}" Margin="0,0,6,0" Height="34" Padding="10,0" />
                    <Button Command="{Binding FilterYesterdayCommand}" Content="أمس" Style="{StaticResource PosSecondaryButton}" Margin="0,0,6,0" Height="34" Padding="10,0" />
                    <Button Command="{Binding FilterThisWeekCommand}" Content="هذا الأسبوع" Style="{StaticResource PosSecondaryButton}" Margin="0,0,6,0" Height="34" Padding="10,0" />
                    <Button Command="{Binding FilterThisMonthCommand}" Content="هذا الشهر" Style="{StaticResource PosSecondaryButton}" Margin="0,0,6,0" Height="34" Padding="10,0" />

                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource PosActionButton}" Margin="8,0,0,0" Height="34" Padding="16,0" Background="#4F46E5">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconReports}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="عرض التقرير" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- زر تصدير Excel الرسمي عبر ClosedXML -->
                <Button Grid.Column="1" Command="{Binding ExportExcelCommand}" Style="{StaticResource PosActionButton}" Background="#059669" Height="38" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconReports}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="تصدير إلى Excel (.xlsx)" FontWeight="Bold" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 2) كروت المؤشرات المالية للفترة المحددة -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- كرت 1: المبيعات الإجمالية -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="14,12" Margin="0,0,8,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي المبيعات" Foreground="#64748B" FontSize="12" />
                    <TextBlock Text="{Binding SalesSummary.TotalSalesPounds, StringFormat='{}{0:N2} ج.م'}" Foreground="#1E1B4B" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding SalesSummary.TotalInvoicesCount, StringFormat='{}عدد الفواتير: {0}'}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- كرت 2: صافي الأرباح -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="14,12" Margin="0,0,8,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="صافي أرباح المبيعات" Foreground="#64748B" FontSize="12" />
                    <TextBlock Text="{Binding SalesSummary.NetProfitPounds, StringFormat='{}{0:N2} ج.م'}" Foreground="#059669" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding SalesSummary.ProfitMarginPercent, StringFormat='{}هامش الربح: {0:F1}%'}" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- كرت 3: مبيعات الكاش والشبكة -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="14,12" Margin="0,0,8,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="المبيعات النقدية" Foreground="#64748B" FontSize="12" />
                    <TextBlock Text="{Binding SalesSummary.CashSalesPounds, StringFormat='{}{0:N2} ج.م'}" Foreground="#0284C7" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding SalesSummary.NetworkSalesPounds, StringFormat='{}الشبكة: {0:N2} ج.م'}" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- كرت 4: ضريبة القيمة المضافة -->
            <Border Grid.Column="3" Background="White" CornerRadius="10" Padding="14,12" Margin="0,0,8,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ضريبة القيمة المضافة" Foreground="#64748B" FontSize="12" />
                    <TextBlock Text="{Binding SalesSummary.TotalVatPounds, StringFormat='{}{0:N2} ج.م'}" Foreground="#7C3AED" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="مخرجات الضريبة للفترة" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- كرت 5: المبيعات الآجلة -->
            <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="14,12" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="المبيعات الآجلة" Foreground="#64748B" FontSize="12" />
                    <TextBlock Text="{Binding SalesSummary.OnAccountSalesPounds, StringFormat='{}{0:N2} ج.م'}" Foreground="#D97706" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="على حساب العملاء" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3) محتوى التقرير والتبويبات -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- أزرار تبديل التقارير -->
                    <RowDefinition Height="Auto" />
                    <!-- مساحة الجدول -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- شريط أزرار التبويبات -->
                <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="فواتير المبيعات التفصيلية" Style="{StaticResource SidebarNavButton}" Width="Auto" Padding="16,8" Margin="0,0,8,0" IsChecked="True" Tag="0"
                                     Command="{Binding RefreshCommand}">
                            <RadioButton.Triggers>
                                <EventTrigger RoutedEvent="RadioButton.Checked">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Tag">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </RadioButton.Triggers>
                        </RadioButton>

                        <TabControl SelectedIndex="{Binding SelectedReportTabIndex, Mode=TwoWay}" Visibility="Collapsed" />

                        <!-- أزرار التبديل بالـ MVVM عبر SelectedReportTabIndex -->
                        <Button Content="فواتير المبيعات" Command="{Binding RefreshCommand}" Style="{StaticResource PosSecondaryButton}" Margin="0,0,6,0" Padding="14,6" />
                    </StackPanel>
                </Border>

                <!-- المحتوى الرئيسي: التبويبات الفعلية عبر TabControl مع إخفاء الهيدر التقليدي واستخدام أزرار أنيقة -->
                <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedReportTabIndex, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
                    <!-- تبويب 0: فواتير المبيعات -->
                    <TabItem Header="فواتير المبيعات" Visibility="Visible">
                        <DataGrid ItemsSource="{Binding SalesReportRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="36" AlternatingRowBackground="#F8FAFC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="140" FontWeight="Bold" />
                                <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding Date, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" Width="150" />
                                <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*" />
                                <DataGridTextColumn Header="طريقة السداد" Binding="{Binding PaymentMethodName}" Width="110" />
                                <DataGridTextColumn Header="المجموع (ج.م)" Binding="{Binding SubtotalPiastres, Converter={x:Null}, StringFormat='{}{0:N2}'}" Width="120" />
                                <DataGridTextColumn Header="الضريبة (ج.م)" Binding="{Binding VatPounds, StringFormat='{}{0:N2} ج.م'}" Width="120" />
                                <DataGridTextColumn Header="الإجمالي النهائي" Binding="{Binding TotalPounds, StringFormat='{}{0:N2} ج.م'}" Width="140" FontWeight="Bold" Foreground="#1E1B4B" />
                                <DataGridTextColumn Header="الربح التقديري" Binding="{Binding ProfitPounds, StringFormat='{}{0:N2} ج.م'}" Width="130" FontWeight="Bold" Foreground="#059669" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- تبويب 1: حركة الأصناف والأكثر مبيعاً -->
                    <TabItem Header="حركة الأصناف" Visibility="Visible">
                        <DataGrid ItemsSource="{Binding ItemMovementRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="36" AlternatingRowBackground="#F8FAFC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="كود الصنف" Binding="{Binding ItemCode}" Width="100" FontWeight="Bold" />
                                <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="140" />
                                <DataGridTextColumn Header="اسم الصنف / الدواء" Binding="{Binding NameAr}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="الكمية المباعة (وحدة)" Binding="{Binding TotalSoldSmallestUnits}" Width="140" FontWeight="Bold" Foreground="#2563EB" />
                                <DataGridTextColumn Header="المخزون الحالي" Binding="{Binding CurrentStockSmallestUnits}" Width="120" />
                                <DataGridTextColumn Header="إجمالي الإيرادات" Binding="{Binding TotalRevenuePounds, StringFormat='{}{0:N2} ج.م'}" Width="140" FontWeight="Bold" />
                                <DataGridTextColumn Header="صافي الربح" Binding="{Binding TotalProfitPounds, StringFormat='{}{0:N2} ج.م'}" Width="130" FontWeight="Bold" Foreground="#059669" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- تبويب 2: النواقص وإعادة الطلب -->
                    <TabItem Header="النواقص وإعادة الطلب" Visibility="Visible">
                        <DataGrid ItemsSource="{Binding LowStockRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="36" AlternatingRowBackground="#FEF2F2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="كود الصنف" Binding="{Binding ItemCode}" Width="110" FontWeight="Bold" />
                                <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="140" />
                                <DataGridTextColumn Header="اسم الدواء" Binding="{Binding NameAr}" Width="*" FontWeight="Bold" />
                                <DataGridTextColumn Header="الرصيد الفعلي الحالي" Binding="{Binding CurrentStockSmallestUnits}" Width="150" FontWeight="Bold" Foreground="#DC2626" />
                                <DataGridTextColumn Header="حد الطلب الأدنى" Binding="{Binding MinStockAlertSmallestUnits}" Width="130" />
                                <DataGridTextColumn Header="مقدار العجز" Binding="{Binding DeficitUnits}" Width="110" Foreground="#B91C1C" FontWeight="Bold" />
                                <DataGridTextColumn Header="الكمية المقترحة للطلب" Binding="{Binding SuggestedOrderUnits}" Width="160" FontWeight="Bold" Foreground="#4F46E5" />
                                <DataGridTextColumn Header="سعر البيع للعلبة" Binding="{Binding RetailPriceBoxPounds, StringFormat='{}{0:N2} ج.م'}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- تبويب 3: صلاحيات الأدوية (FEFO) -->
                    <TabItem Header="صلاحيات الأدوية" Visibility="Visible">
                        <DataGrid ItemsSource="{Binding ExpiryRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="36" AlternatingRowBackground="#FFFBEB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="كود الصنف" Binding="{Binding ItemCode}" Width="110" FontWeight="Bold" />
                                <DataGridTextColumn Header="اسم الدواء" Binding="{Binding NameAr}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="رقم التشغيلة (Batch)" Binding="{Binding BatchNumber}" Width="150" />
                                <DataGridTextColumn Header="تاريخ الانتهاء" Binding="{Binding ExpiryDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="130" FontWeight="Bold" />
                                <DataGridTextColumn Header="الحالة والأيام المتبقية" Binding="{Binding StatusDisplay}" Width="160" FontWeight="Bold" Foreground="#D97706" />
                                <DataGridTextColumn Header="الكمية المتبقية" Binding="{Binding RemainingSmallestUnits}" Width="130" FontWeight="Bold" />
                                <DataGridTextColumn Header="قيمة التكلفة" Binding="{Binding TotalCostPounds, StringFormat='{}{0:N2} ج.م'}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- تبويب 4: التقييم المالي للمخزون -->
                    <TabItem Header="التقييم المالي للمخزون" Visibility="Visible">
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="24" Margin="10">
                            <StackPanel MaxWidth="700" HorizontalAlignment="Center">
                                <TextBlock Text="التقييم المالي الشامل لمخزون الصيدلية" FontSize="18" FontWeight="Bold" Foreground="#1E1B4B" Margin="0,0,0,16" TextAlignment="Center" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="إجمالي عدد الأصناف المعرفة:" FontSize="15" Foreground="#475569" />
                                    <TextBlock Grid.Column="1" Text="{Binding ValuationSummary.TotalItemsCount}" FontSize="16" FontWeight="Bold" Foreground="#1E1B4B" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="إجمالي عدد التشغيلات (Batches) النشطة:" FontSize="15" Foreground="#475569" />
                                    <TextBlock Grid.Column="1" Text="{Binding ValuationSummary.TotalBatchesCount}" FontSize="16" FontWeight="Bold" Foreground="#1E1B4B" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="إجمالي الوحدات الصغرى المخزنة:" FontSize="15" Foreground="#475569" />
                                    <TextBlock Grid.Column="1" Text="{Binding ValuationSummary.TotalSmallestUnitsCount}" FontSize="16" FontWeight="Bold" Foreground="#1E1B4B" />
                                </Grid>

                                <Separator Margin="0,10" Background="#CBD5E1" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="قيمة المخزون بسعر الشراء (التكلفة):" FontSize="15" FontWeight="SemiBold" Foreground="#475569" />
                                    <TextBlock Grid.Column="1" Text="{Binding ValuationSummary.TotalValuationCostPounds, StringFormat='{}{0:N2} ج.م'}" FontSize="18" FontWeight="Bold" Foreground="#2563EB" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="قيمة المخزون بسعر البيع (التجزئة):" FontSize="15" FontWeight="SemiBold" Foreground="#475569" />
                                    <TextBlock Grid.Column="1" Text="{Binding ValuationSummary.TotalValuationRetailPounds, StringFormat='{}{0:N2} ج.م'}" FontSize="18" FontWeight="Bold" Foreground="#7C3AED" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="صافي الأرباح المتوقعة عند تمام البيع:" FontSize="16" FontWeight="Bold" Foreground="#065F46" />
                                    <TextBlock Grid.Column="1" Text="{Binding ValuationSummary.ExpectedProfitPounds, StringFormat='{}{0:N2} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="#059669" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- 4) شريط الحالة السفلي -->
        <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="8" Padding="12,6" Margin="0,8,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
