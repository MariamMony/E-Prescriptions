<Window x:Class="ePrescriptions.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ePrescriptions.App.ViewModels"
        xmlns:views="clr-namespace:ePrescriptions.App.Views"
        mc:Ignorable="d"
        Title="e_prescriptions - النظام المتكامل لإدارة الصيدليات والوصفات الطبية"
        Height="800" Width="1366"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundGradient}">

    <!-- تعيين DataTemplates لربط كل ViewModel بـ View الخاصة به -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
            <views:PurchasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupplierReturnsViewModel}">
            <views:SupplierReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinanceViewModel}">
            <views:FinanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffViewModel}">
            <views:StaffView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ZakatViewModel}">
            <views:ZakatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}">
            <views:HelpView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OwnerLogViewModel}">
            <views:OwnerLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffAuditLogViewModel}">
            <views:StaffAuditLogView />
        </DataTemplate>
    </Window.Resources>

    <!-- اختصارات لوحة المفاتيح العامة (F1..F10) -->
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding CurrentView.NewInvoiceCommand}" />
        <KeyBinding Key="F2" Command="{Binding CurrentView.SaveInvoiceCommand}" />
        <KeyBinding Key="F3" Command="{Binding CurrentView.PrintInvoiceCommand}" />
        <KeyBinding Key="F8" Command="{Binding CurrentView.SuspendInvoiceCommand}" />
        <KeyBinding Key="F9" Command="{Binding CurrentView.ToggleReturnModeCommand}" />
        <KeyBinding Key="F10" Command="{Binding CurrentView.OpenCashDrawerCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- الشريط العلوي الرئيسي مع الساعة الحية وحالة المستخدم -->
            <RowDefinition Height="56" />
            <!-- المحتوى والشريط الجانبي -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1) الشريط العلوي العام للتطبيق -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- اسم وشعار الصيدلية والنظام -->
                    <ColumnDefinition Width="Auto" />
                    <!-- شريط التاريخ الهجري والميلادي والوقت المباشر (يتحدث كل ثانية) -->
                    <ColumnDefinition Width="*" />
                    <!-- بيانات المستخدم والوردية وقفل الشاشة -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#4F46E5" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <Path Data="{StaticResource IconInventory}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="e_prescriptions" Foreground="White" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="نظام إدارة الصيدليات والوصفات الطبية" Foreground="#94A3B8" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- شريط الوقت المباشر مع تقويم أم القرى -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#1F2937" CornerRadius="8" Padding="18,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LiveDateTimeString}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Border>

                <!-- المستخدم والوردية الحالية -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ShiftStatusDisplay}" Foreground="#10B981" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Background="#312E81" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                        <TextBlock Text="{Binding CurrentUserDisplay}" Foreground="White" FontWeight="Bold" FontSize="12" />
                    </Border>

                    <!-- زر قفل الشاشة السريع وزر تسجيل الخروج -->
                    <Button Command="{Binding LockScreenCommand}" Background="#1E293B" BorderThickness="0" Cursor="Hand" Padding="10,6" Margin="0,0,6,0">
                        <TextBlock Text="قفل الشاشة" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold" />
                    </Button>
                    <Button Command="{Binding LogoutCommand}" Background="#450A0A" BorderThickness="0" Cursor="Hand" Padding="10,6">
                        <TextBlock Text="خروج" Foreground="#FCA5A5" FontSize="11" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2) المحتوى الرئيسي: شريط جانبي يمين + شاشة العرض يسار -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- الشريط الجانبي في اليمين (RTL) -->
                <ColumnDefinition Width="220" />
                <!-- الشاشة المعروضة حالياً -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- الشريط الجانبي للوحدات -->
            <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,12,6,12">
                        <!-- نقطة البيع (المبيعات) - الافتراضية -->
                        <RadioButton Command="{Binding NavigateSalesCommand}" Style="{StaticResource SidebarNavButton}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSales}" Fill="#38BDF8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="المبيعات (F1)" FontWeight="Bold" />
                            </StackPanel>
                        </RadioButton>

                        <!-- إدارة المخزون والأدوية -->
                        <RadioButton Command="{Binding NavigateInventoryCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessInventory, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconInventory}" Fill="#A78BFA" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="المخزون والأدوية" />
                            </StackPanel>
                        </RadioButton>

                        <!-- المشتريات والموردون -->
                        <RadioButton Command="{Binding NavigatePurchasesCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessPurchases, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPurchases}" Fill="#34D399" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="المشتريات والموردون" />
                            </StackPanel>
                        </RadioButton>

                        <!-- مرتجع / إتلاف المنتهي -->
                        <RadioButton Command="{Binding NavigateSupplierReturnsCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessPurchases, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPurchases}" Fill="#FB923C" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="مرتجع / إتلاف المنتهي" />
                            </StackPanel>
                        </RadioButton>

                        <!-- العملاء والآجل -->
                        <RadioButton Command="{Binding NavigateCustomersCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessCustomers, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCustomers}" Fill="#F472B6" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="حسابات العملاء" />
                            </StackPanel>
                        </RadioButton>

                        <!-- المالية والمصروفات -->
                        <RadioButton Command="{Binding NavigateFinanceCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessFinance, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFinance}" Fill="#FBBF24" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="الحسابات والمالية" />
                            </StackPanel>
                        </RadioButton>

                        <!-- سجل نشاطي: يظهر فقط لحساب صاحب الصيدلية -->
                        <RadioButton Command="{Binding NavigateOwnerLogCommand}" Style="{StaticResource SidebarNavButton}"
                                     Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconReports}" Fill="#A855F7" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="سجل نشاطي" />
                            </StackPanel>
                        </RadioButton>

                        <!-- سجل نشاط الموظفين: يظهر للمدير وصاحب الصيدلية فقط (لا يحتوي تعديلات Owner) -->
                        <RadioButton Command="{Binding NavigateStaffAuditLogCommand}" Style="{StaticResource SidebarNavButton}"
                                     Visibility="{Binding IsAdminOrOwner, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconReports}" Fill="#0EA5E9" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="سجل نشاط الموظفين" />
                            </StackPanel>
                        </RadioButton>

                        <!-- الموظفون والورديات -->
                        <RadioButton Command="{Binding NavigateStaffCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessStaff, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconStaff}" Fill="#818CF8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="الموظفون والورديات" />
                            </StackPanel>
                        </RadioButton>

                        <!-- حساب الزكاة الشرعية -->
                        <RadioButton Command="{Binding NavigateZakatCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessZakat, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconZakat}" Fill="#4ADE80" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="حاسبة الزكاة" />
                            </StackPanel>
                        </RadioButton>

                        <!-- التقارير الشاملة -->
                        <RadioButton Command="{Binding NavigateReportsCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessReports, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconReports}" Fill="#60A5FA" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="التقارير والإحصاءات" />
                            </StackPanel>
                        </RadioButton>

                        <Separator Background="#1F2937" Margin="8,14" />

                        <!-- الإعدادات والطابعات -->
                        <RadioButton Command="{Binding NavigateSettingsCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessSettings, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSettings}" Fill="#94A3B8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="إعدادات النظام" />
                            </StackPanel>
                        </RadioButton>

                        <!-- شاشة الاختصارات والمساعدة -->
                        <RadioButton Command="{Binding NavigateHelpCommand}" Style="{StaticResource SidebarNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHelp}" Fill="#38BDF8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="الاختصارات والتعليمات" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- منطقة عرض الشاشة الحالية -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="6" />
        </Grid>
    </Grid>
</Window>
